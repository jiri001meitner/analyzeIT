# ==============================================================================
# analyzeIT - Environment Configuration Template
# Copy this file to .env and configure your local values:
# cp .env.example .env
# WARNING: NEVER commit the actual .env file to Git!
# ==============================================================================

# Application environment (development | production)
ANALYZEIT_ENV=development

# Unix Domain Socket path for Caddy reverse proxy integration
SOCKET_PATH=/var/run/analyzeit.sock

# NATS JetStream message broker configuration
NATS_URL=nats://localhost:4222
NATS_STREAM_NAME=ANALYTICS_EVENTS
NATS_SUBJECT_HIT=analytics.raw.hit

# Databend analytical storage (Rust Data Warehouse)
DATABEND_DSN=databend://root:@localhost:8000/analyzeit

# SQLite configuration and state database (WAL mode)
SQLITE_DB_PATH=./data/analyzeit.db

# IP storage and privacy configuration:
# Modes: full (store full IP), mask_1_byte (/24), mask_2_bytes (/16), hash (salted hash)
IP_STORAGE_MODE=full

# GDPR salt rotation interval in hours (used when IP_STORAGE_MODE=hash)
IP_SALT_ROTATION_HOURS=24

# Dual-stack IPv4/IPv6 and STUN probing toggles
ENABLE_DUALSTACK_PROBE=true
ENABLE_WEBRTC_STUN_PROBE=false
STUN_PORT=3478

# Wasm runtime (Wazero) execution boundaries
WASM_MEMORY_LIMIT_MB=64
WASM_CPU_TIMEOUT_MS=5000

# Wasm Marketplace and Bitcoin Lightning integration
# Options: mock, lnbits, btcpayserver
LIGHTNING_BACKEND=mock
LIGHTNING_API_URL=
LIGHTNING_API_KEY=
MARKETPLACE_PUBLIC_KEY=
