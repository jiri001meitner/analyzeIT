#!/usr/bin/env bash
# ==============================================================================
# analyzeIT pre-commit hook: Prevent committing secrets, credentials, and caches
# ==============================================================================
set -euo pipefail

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

ERRORS=0

# 1. Check staged filenames against prohibited patterns
STAGED_FILES=$(git diff --cached --name-only)

if [ -n "$STAGED_FILES" ]; then
    while IFS= read -r file; do
        # Prohibited environment files (.env* except .env.example)
        if [[ "$file" =~ ^\.env ]] && [[ "$file" != ".env.example" ]]; then
            echo -e "${RED}[ERROR] Attempting to commit environment file: ${file}${NC}"
            echo "   Files matching .env contain sensitive data and must remain local."
            ERRORS=$((ERRORS + 1))
        fi

        # Certificates and private keys
        if [[ "$file" =~ \.(pem|key|pfx|p12|keystore)$ ]] || [[ "$file" =~ id_rsa|id_ed25519 ]]; then
            echo -e "${RED}[ERROR] Attempting to commit private key or certificate: ${file}${NC}"
            ERRORS=$((ERRORS + 1))
        fi

        # Databases and runtime sockets
        if [[ "$file" =~ \.(db|sqlite|sqlite3|sock)$ ]] || [[ "$file" =~ \.db-(wal|shm|journal)$ ]]; then
            echo -e "${RED}[ERROR] Attempting to commit database or socket file: ${file}${NC}"
            ERRORS=$((ERRORS + 1))
        fi

        # Build caches and binary artifacts
        if [[ "$file" =~ \.gocache/ ]] || [[ "$file" =~ target/ ]] || [[ "$file" =~ node_modules/ ]] || [[ "$file" =~ __pycache__/ ]] || [[ "$file" =~ \.wasm$ ]]; then
            echo -e "${RED}[ERROR] Attempting to commit cache or compiled binary artifact: ${file}${NC}"
            ERRORS=$((ERRORS + 1))
        fi

        # Cloud and service credentials
        if [[ "$file" =~ credentials\.json$ ]] || [[ "$file" =~ service-account.*\.json$ ]] || [[ "$file" =~ \.vault$ ]]; then
            echo -e "${RED}[ERROR] Attempting to commit cloud credentials: ${file}${NC}"
            ERRORS=$((ERRORS + 1))
        fi
    done <<< "$STAGED_FILES"
fi

# 2. Check staged content for leaked secrets and private keys
DIFF_OUTPUT=$(git diff --cached -U0)

if echo "$DIFF_OUTPUT" | grep -qE "^\+[[:space:]]*-----BEGIN ([A-Z0-9 ]+)?PRIVATE KEY-----"; then
    echo -e "${RED}[ERROR] Found private key block (PRIVATE KEY) in staged diff!${NC}"
    ERRORS=$((ERRORS + 1))
fi

if echo "$DIFF_OUTPUT" | grep -qE "^\+[[:space:]]*AKIA[0-9A-Z]{16}"; then
    echo -e "${RED}[ERROR] Found AWS Access Key ID (AKIA...) in staged diff!${NC}"
    ERRORS=$((ERRORS + 1))
fi

if echo "$DIFF_OUTPUT" | grep -qE "^\+[[:space:]]*(ghp_[0-9a-zA-Z]{36}|github_pat_[0-9a-zA-Z_]{82})"; then
    echo -e "${RED}[ERROR] Found GitHub Personal Access Token in staged diff!${NC}"
    ERRORS=$((ERRORS + 1))
fi

if [ "$ERRORS" -gt 0 ]; then
    echo -e "\n${RED}Commit rejected for security violations (${ERRORS} errors).${NC}"
    echo -e "Remove sensitive data or caches from the git index (e.g., 'git reset HEAD <file>').\n"
    exit 1
fi

exit 0
